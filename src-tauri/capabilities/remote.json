{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote",
  "description": "Restricted capability for the loopback-hosted SPA (no shell or filesystem access).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "dialog:default",
    "process:default",
    "updater:default",
    "desktop-commands"
  ]
}
