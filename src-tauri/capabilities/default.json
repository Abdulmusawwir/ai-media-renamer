{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local capability for the shell and splash windows.",
  "windows": ["main", "splash"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "dialog:default",
    "process:default",
    "updater:default"
  ]
}
