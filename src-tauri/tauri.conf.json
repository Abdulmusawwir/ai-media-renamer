{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Media Renamer",
  "version": "2.2.2",
  "identifier": "com.abdulmusawwir.ai-media-renamer",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../src-tauri/splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Media Renamer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/AIMediaRenamerBackend/": "AIMediaRenamerBackend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Abdulmusawwir/ai-media-renamer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQUFEQUU3RTBCREZEMkYKUldRdi9iM2c1OXFxY0Izc21iMGR6OUxXYmU4TCs2eVlNdGJuaCtoclE5SHlWN3VCeHh2Y09LbEwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
